# Токен MAX-бота, выданный @MasterBot в мессенджере MAX
MAX_BOT_TOKEN=your-token-here

# URL базы данных. По умолчанию SQLite в файле data.db рядом с проектом.
# Для PostgreSQL: postgresql+asyncpg://user:pass@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///./data.db

# На сколько дней вперёд бот генерирует свободные слоты для каждого специалиста
SLOT_HORIZON_DAYS=14

# Уровень логирования: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
